# Files and folders that must NOT be committed to git.
# The assignment says "only sources, no build directories", so we exclude every
# generated/build artifact here.

# Dart/Flutter build + tool output
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
pubspec.lock   # a lockfile for an app; the course grades sources, and it is regenerated by `flutter pub get`

# IDE/editor
.idea/
*.iml
.vscode/

# OS files
.DS_Store
Thumbs.db

# Local SDK path (machine-specific)
local.properties
